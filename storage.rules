rules_version = '2';

// Provider registration documents (e.g. registration certificates). The
// owning user (path uid segment) may read/write their own folder; staff
// roles that review providers may read but never write. Everything else
// stays denied - never widen the fallback match below to `if true`.
//
// Applicant personal documents (passport, transcripts, financial documents,
// etc.) are far more sensitive than provider registration paperwork, so
// they stay strictly owner-only for both read and write here - no staff
// role, and no shared-with provider, gets a Storage-rule read grant,
// unlike provider-documents above. Sharing a document with a specific
// provider (ApplicantDocument.grantProviderAccess in the backend) is
// recorded in Postgres, not enforced by widening these rules; a granted
// provider instead reads the file through a signed URL the backend mints
// on demand (GET /applicant-documents/{id}/download-url, gated on that
// same Postgres record - see app/services/document_storage.py), so this
// rule can stay the narrowest possible grant and the backend remains the
// one auditable choke point for third-party access.
// Deletion is allowed here (unlike provider-documents' append-only
// evidence) because DocumentRepository.remove() is a real, owner-driven
// action.
service firebase.storage {
  match /b/{bucket}/o {
    match /provider-documents/{uid}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid ||
         request.auth.token.role in ['verificationOfficer', 'administrator', 'superAdministrator']);
      allow write: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
      allow delete: if false;
    }
    match /applicant-documents/{uid}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
