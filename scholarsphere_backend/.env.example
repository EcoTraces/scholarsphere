# ScholarSphere backend environment configuration.
#
# Copy this file to `.env` for local development (`cp .env.example .env`)
# and fill in real values. NEVER commit a real `.env` file - `.gitignore`
# already excludes it, but double-check before committing if you ever
# rename or copy this file.
#
# Each variable below is labeled with when it's actually required:
#   [REQUIRED: LOCAL DEV]   - the app won't start meaningfully without it
#   [REQUIRED: TESTING]     - pytest needs this (most tests override config
#                             directly and don't need a real .env at all -
#                             see tests/conftest.py)
#   [REQUIRED: BACKGROUND JOBS] - needed for Celery worker/beat (source sync,
#                             expiration, reverification, notifications)
#   [REQUIRED: FIREBASE]    - authentication won't work without it
#   [REQUIRED: PRODUCTION]  - config.py actively refuses to start in
#                             app_env=production with a placeholder/missing
#                             value here (see Settings model validators)
#   [OPTIONAL]               - has a safe default; only set to change behavior
#                              or to enable a specific external-source
#                              integration

# --- Core application -------------------------------------------------

APP_NAME=ScholarSphere API
# [REQUIRED: PRODUCTION] Controls production-only validation (see below) -
# must be exactly "production" to enable it. Any other value (including
# "development", "staging", "test") skips those checks.
APP_ENV=development
API_V1_PREFIX=/api/v1

# --- Database -----------------------------------------------------------

# [REQUIRED: LOCAL DEV] [REQUIRED: PRODUCTION]
# Local dev: docker-compose reads POSTGRES_PASSWORD to set up the `postgres`
# service and substitutes it into DATABASE_URL for you - set POSTGRES_PASSWORD
# and leave DATABASE_URL as-is unless running Postgres yourself.
# Production: config.py refuses to start if this still contains the literal
# string "change-me" - inject the real value from your secret manager.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://scholarsphere:change-me@localhost:5432/scholarsphere

# --- Redis (rate limiting + Celery broker/result backend) --------------

# [REQUIRED: BACKGROUND JOBS] [REQUIRED: PRODUCTION]
# Used by both the API (Redis-backed rate limiter, fails open if
# unreachable - see app/core/rate_limit.py) and Celery (broker + result
# backend - see app/tasks/opportunity_sync.py). Production refuses to start
# if this is still the local-dev default (redis://localhost:6379/0).
REDIS_URL=redis://localhost:6379/0

# --- Firebase authentication ---------------------------------------------

# [REQUIRED: FIREBASE]
FIREBASE_PROJECT_ID=scholarsphere-d44f5
# [OPTIONAL] Matches lib/firebase_options.dart's storageBucket. Used to
# generate signed download URLs for applicant documents an applicant has
# shared with a provider (app/services/document_storage.py) - requires
# FIREBASE_CREDENTIALS_PATH (or an environment with IAM signBlob
# permission) to actually sign; without real credentials this stays
# configured but unusable, matching FIREBASE_CREDENTIALS_PATH below.
FIREBASE_STORAGE_BUCKET=scholarsphere-d44f5.firebasestorage.app
# [OPTIONAL locally, effectively REQUIRED: PRODUCTION unless Application
# Default Credentials are configured instead (e.g. a service account
# attached to the GCP compute environment running this backend).
# If set, must point to a real, readable service-account JSON key file -
# config.py validates the file exists when app_env=production, and
# app/main.py's startup lifespan actually attempts initialization (fails
# fast with a clear error rather than only on the first authenticated
# request). Leave empty for local dev to fall back to signature-only token
# verification (no live revocation checking - see FIREBASE_CHECK_REVOKED).
FIREBASE_CREDENTIALS_PATH=
# [REQUIRED: PRODUCTION - cannot actually be disabled there] Revocation
# checking calls the Identity Toolkit API, which needs a real
# service-account credential. config.py forces this back to true whenever
# app_env=production regardless of what's set here. Set false only for
# local/demo runs that have no FIREBASE_CREDENTIALS_PATH and just need
# basic token signature checks.
FIREBASE_CHECK_REVOKED=true

# --- CORS -----------------------------------------------------------------

# [OPTIONAL] Comma-separated. Update for your real frontend origin(s) in
# any non-local deployment - the default only allows localhost. Deploying
# the Flutter web build to GitHub Pages via
# .github/workflows/deploy-pages.yml? Add https://<owner>.github.io here
# (e.g. https://ecotraces.github.io) - that's the site's real origin for
# CORS purposes even for a project page served under a /<repo>/ path,
# since CORS matches scheme+host+port only, never the path. No
# scheme-less or wildcard entries - an exact "scheme://host[:port]" is
# required.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- HTTP client (shared by every external API/scraper source) -----------

# [OPTIONAL] Applies to every outbound call this backend makes - official
# APIs (app/core/http_client.py::get_json/post_json) and the web-scraper
# sources (::get_html). Defaults are sane for most deployments.
HTTP_TIMEOUT_SECONDS=40
HTTP_MAX_RETRIES=3
HTTP_MAX_RESPONSE_BYTES=5242880
MAX_REQUEST_BYTES=1048576

# --- Browser-rendering fallback (app/services/browser_rendering.py) ------

# [OPTIONAL] Only exercised by a scraper source that opts in via
# `allow_browser_rendering = True` (see app/services/web_scraper_base.py),
# and only when that source's plain-HTTP fetch looks like an unrendered
# JavaScript shell. BROWSER_RENDER_TIMEOUT_MS/BROWSER_RENDER_MAX_CONCURRENCY
# bound its resource cost. BROWSER_EXECUTABLE_PATH should stay empty in
# every real deployment - the Dockerfile's own `playwright install
# --with-deps chromium` step manages a matching browser at Playwright's
# default location; only set this to point at a pre-installed browser
# binary whose revision doesn't match the pinned `playwright` package
# version (e.g. a dev sandbox with its own fixed Chromium build).
BROWSER_RENDER_TIMEOUT_MS=20000
BROWSER_RENDER_MAX_CONCURRENCY=2
BROWSER_EXECUTABLE_PATH=
# [OPTIONAL] Headless is the only correct mode for a server process (no
# display). Set to false only in your own local .env, temporarily, to
# watch a specific source's render happen while debugging it -
# config.py forces this back to true whenever APP_ENV=production.
PLAYWRIGHT_HEADLESS=true
# [OPTIONAL] Auto-accepts a cookie/consent banner ONLY when it's actively
# blocking access to a page's public content (see
# app/services/browser_rendering.py's `_maybe_accept_cookie_banner`) -
# never clicks marketing/tracking opt-ins, only "required" access banners.
AUTO_ACCEPT_REQUIRED_COOKIES=true

# --- Pagination / infinite-scroll engines (app/services/pagination_engine.py,
# app/services/infinite_scroll_engine.py) --------------------------------

# [OPTIONAL] Ceilings any source using these engines shares unless it
# explicitly overrides them - stops a "Next"/"Load more"/scroll loop even
# if the page's own control never disables itself.
MAX_PAGES_PER_SOURCE=50
MAX_RECORDS_PER_SOURCE=5000
MAX_SCROLL_ITERATIONS=50
SCROLL_STAGNATION_LIMIT=3

# --- API-wide rate limiting -----------------------------------------------

# [OPTIONAL] Fixed-window limit per client IP, backed by Redis; fails open
# (allows requests) if Redis is unreachable - defense-in-depth, not a
# correctness guarantee. See app/core/rate_limit.py.
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# --- Official-API opportunity sources --------------------------------

# Grants.gov / Simpler.Grants.gov (US federal grants) - [OPTIONAL],
# Grants.gov needs no key; Simpler.Grants.gov does.
GRANTS_GOV_BASE_URL=https://api.grants.gov/v1/api
SIMPLER_GRANTS_BASE_URL=https://api.simpler.grants.gov
SIMPLER_GRANTS_API_KEY=

# EU Funding & Tenders Portal - [OPTIONAL]. EU_FUNDING_API_KEY defaults to
# "SEDIA", the portal's own published non-secret literal key used by every
# consumer of this open API - not a credential to keep private.
EU_FUNDING_API_URL=https://api.tech.ec.europa.eu/search-api/prod/rest/search
EU_FUNDING_API_KEY=SEDIA
EU_FUNDING_TYPE_CODES=1,2,8
EU_FUNDING_STATUS_CODES=31094501,31094502
EU_FUNDING_PROGRAMME_PERIOD=2021 - 2027
EU_FUNDING_LANGUAGE=en
EU_FUNDING_DISPLAY_FIELDS=type,identifier,reference,callccm2Id,title,status,caName,projectAcronym,startDate,description,deadlineDate,deadlineModel,frameworkProgramme,programmePeriod,typesOfAction,budgetOverview,keywords
EU_FUNDING_TYPE_MAPPINGS=1:grant,2:grant,8:cascade_funding
EU_FUNDING_STATUS_MAPPINGS=31094501:forthcoming,31094502:open,31094503:closed

# USAJOBS - [OPTIONAL to boot; source sync fails cleanly without it].
# USAJOBS_API_KEY: free self-service key from developer.usajobs.gov.
# USAJOBS_USER_AGENT: MUST be the exact email address registered with that
# key - USAJOBS uses it as part of authentication, not a generic client
# string. Never smoke-tested against a live authenticated response in any
# environment this project has had access to - see Task.md.
USAJOBS_BASE_URL=https://data.usajobs.gov/api/search
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# ReliefWeb (UN OCHA) - [OPTIONAL to boot; source sync fails cleanly
# without it]. RELIEFWEB_APPNAME is a pre-approved application identifier
# (not a secret) - request one per apidoc.reliefweb.int.
RELIEFWEB_BASE_URL=https://api.reliefweb.int/v2
RELIEFWEB_APPNAME=

# EducationUSA "Find Financial Aid" database (US Department of State) -
# [OPTIONAL] no API key needed. See app/services/educationusa_source.py.
EDUCATIONUSA_BASE_URL=https://educationusa.state.gov

# --- Web-scraper opportunity sources ---------------------------------
#
# [OPTIONAL] No API key needed for any of these - they scrape each
# organization's own public pages because none publish an official API,
# RSS feed, or dataset (see docs/AUTHORITATIVE_SOURCES.md #8-#12). Base
# URLs below are the code defaults (app/core/config.py); only set these to
# override for testing against a staging mirror or similar.
CSCUK_BASE_URL=https://cscuk.fcdo.gov.uk
CHEVENING_BASE_URL=https://www.chevening.org
DAAD_BASE_URL=https://www2.daad.de
# Comma-separated DAAD scholarship-database detail-page ids to monitor -
# see the code default and comment in app/core/config.py for why this is a
# curated list rather than a full-catalog crawl.
DAAD_SCHOLARSHIP_DETAIL_IDS=50026200,50076777,57742121,57742130,57135739,10000486
CHINA_EMBASSY_SL_BASE_URL=https://sl.china-embassy.gov.cn
# Confirmed unreachable from every environment this project has had access
# to as of 2026-08-22 (connection refused, both http/https) - see Task.md
# and docs/AUTHORITATIVE_SOURCES.md #12. Overriding this won't fix that;
# it's listed for completeness and future re-testing.
MTHE_SL_BASE_URL=https://www.mthe.gov.sl

# --- Premium Application-Preparation Platform: payment provider ----------
#
# [OPTIONAL to boot] Everything premium-payment-related is fully
# implemented and testable with this section left blank -
# app/services/payment_provider.py::get_payment_provider() falls back to
# NullPaymentProvider, which clearly reports "payment provider is not
# configured" on every call rather than fabricating a successful
# transaction. Fill these in once a real provider (Stripe/
# Paystack/Flutterwave/...) is chosen; the PaymentProvider interface is
# provider-agnostic, so no application code changes when you do.
#
# PAYMENT_PROVIDER selects the adapter by name (e.g. "stripe"); leave
# blank until a provider is actually chosen and its adapter registered in
# payment_provider.py's PROVIDER_REGISTRY.
PAYMENT_PROVIDER=
# "test" or "live" - forwarded to the adapter, never inferred from
# APP_ENV (a staging deployment may legitimately need live payment mode
# for a real end-to-end check, or vice versa).
PAYMENT_ENV=test
# NEVER logged, NEVER sent to the frontend - server-side only.
PAYMENT_SECRET_KEY=
# Safe to expose to the frontend (e.g. a Stripe "publishable key") -
# still kept here rather than hardcoded so it's swappable per
# environment.
PAYMENT_PUBLIC_KEY=
# HMAC secret used to verify an inbound webhook actually came from the
# configured provider (app/services/payment_provider.py's
# verify_webhook_signature) - NEVER logged.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD
# The provider's own REST API base URL, if the chosen adapter calls one
# directly via app/core/http_client.py (must be HTTPS if set).
PAYMENT_API_BASE_URL=

# [OPTIONAL] Controls only the one-time seed of the flagship "Complete
# Premium Application Package" plan row (app/services/premium_plan_seed.py)
# - the database row is the real source of truth afterward; changing these
# after the plan already exists has no effect. Price is in cents (10000 =
# $100.00).
PREMIUM_PLAN_ID=complete_premium
PREMIUM_PRICE_CENTS=10000

# --- Premium Application-Preparation Platform: AI provider ---------------
#
# [OPTIONAL to boot] Same fallback pattern as payments -
# app/services/ai_provider.py::get_ai_provider() falls back to
# NullAIProvider when AI_PROVIDER is blank, which clearly reports
# "AI generation is not configured" rather than fabricating document
# content. Set AI_PROVIDER to "openai" or "anthropic" to use one of the
# two built-in adapters (each calls its provider's real REST API via
# app/core/http_client.py), or add a new adapter for another provider
# without touching any calling code.
AI_PROVIDER=
# NEVER logged, NEVER sent to the frontend - server-side only.
AI_API_KEY=
# e.g. "gpt-4o" or "claude-sonnet-5" depending on AI_PROVIDER - no
# default; the app refuses an AI generation request with a clear
# "not configured" error until this is set.
AI_MODEL=
# Only needed to point an adapter at a non-default API base URL (e.g. an
# Azure OpenAI deployment or a compatible proxy) - must be HTTPS if set.
AI_API_BASE_URL=
AI_REQUEST_TIMEOUT_SECONDS=60
# Configurable per-user AI-usage ceilings, enforced by
# app/services/usage_limits.py - the `usage_limits` database table can
# override these per feature; these are only the defaults applied when no
# row exists yet.
AI_USAGE_DAILY_LIMIT_DEFAULT=20
AI_USAGE_MONTHLY_LIMIT_DEFAULT=200
