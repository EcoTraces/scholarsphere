rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdministrator() {
      return signedIn() &&
        request.auth.token.role in [
          'administrator',
          'securityAdministrator',
          'superAdministrator'
        ];
    }

    function isOwnUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create: if isOwnUser(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'applicant' &&
        (
          request.resource.data.status == 'pendingVerification' ||
          (
            request.auth.token.email_verified == true &&
            request.resource.data.status == 'active'
          )
        );

      allow read: if isOwnUser(userId) || isAdministrator();

      allow update: if isOwnUser(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.emailVerified ==
          request.auth.token.email_verified &&
        (
          request.resource.data.status == resource.data.status ||
          (
            request.auth.token.email_verified == true &&
            request.resource.data.status == 'active'
          )
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'emailVerified',
          'status',
          'marketingEmailsEnabled',
          'deadlineNotificationsEnabled',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
