# The Flutter client (lib/) does NOT load a .env file at runtime -- it has no
# flutter_dotenv dependency and no env-file-reading code. The only build-time
# configuration knob it reads is SCHOLARSPHERE_API_BASE_URL, supplied via
# --dart-define at build time, e.g.:
#
#   flutter build web --release \
#     --dart-define=SCHOLARSPHERE_API_BASE_URL=https://api.example.org/api/v1
#
# This file exists purely as a reference for that value; it is never read by
# any tool automatically. For the backend's real .env, see
# scholarsphere_backend/.env.example.

SCHOLARSPHERE_API_BASE_URL=https://api.example.invalid/api/v1
